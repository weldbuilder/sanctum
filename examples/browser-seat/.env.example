# Copy to .env (same folder as docker-compose.yml) and edit. .env is never committed.

# REQUIRED. Password the viewer asks for. Only the first 8 characters count (VNC limit).
BROWSER_SEAT_VNC_PASSWORD=

# Host address the viewer (noVNC) is published on. Keep 127.0.0.1 unless you are putting it
# on a private network (VPN/tailnet): then set that interface's address. Never 0.0.0.0 on a public host.
BROWSER_SEAT_BIND=127.0.0.1

# Host port for the viewer.
BROWSER_SEAT_PORT=6080

# Host port for the DevTools Protocol. Always published on 127.0.0.1 only; the address is not configurable.
BROWSER_SEAT_CDP_PORT=9222

# Virtual screen size (WIDTHxHEIGHTxDEPTH).
BROWSER_SEAT_RESOLUTION=1600x1000x24

TZ=Etc/UTC
