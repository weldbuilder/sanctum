# cp .env.example .env and set passwords (generate: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)
NEKO_SEAT_USER_PASSWORD=
NEKO_SEAT_ADMIN_PASSWORD=
# Login: any username + the user password (or the admin password for admin rights).
# 127.0.0.1 = this machine only. For a phone, set your tailnet/VPN address (never 0.0.0.0).
NEKO_SEAT_BIND=127.0.0.1
# Same address: what neko tells the phone to send WebRTC media to.
NEKO_SEAT_NAT_IP=127.0.0.1
NEKO_SEAT_PORT=3201
NEKO_SEAT_RTC_PORT=52000
NEKO_SEAT_CDP_PORT=9232
NEKO_SEAT_SCREEN=1600x1000@30
# true = the first viewer to click/tap the stream takes control (no "request control" tap); false = explicit requests.
NEKO_SEAT_IMPLICIT_HOSTING=true
