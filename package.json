{
  "name": "sanctum-mobile",
  "version": "1.3.0",
  "private": true,
  "description": "Sanctum Mobile: a local home for your companion, and an app to talk to them from your phone. Runs on Codex or Claude.",
  "repository": "github:weldbuilder/sanctum",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/backend",
    "build": "node scripts/build.mjs",
    "build:stamp": "node scripts/write-build-id.mjs",
    "prompts:build": "node scripts/build-prompts.mjs",
    "start": "npm run start --workspace=packages/backend",
    "check": "npm run build --workspace=packages/shared && npm run check --workspaces --if-present",
    "test": "vitest run",
    "update": "node scripts/update.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "overrides": {
    "undici": "^6.24.0",
    "cookie": "^1.0.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.18",
    "ip-address": "^10.1.1"
  }
}
